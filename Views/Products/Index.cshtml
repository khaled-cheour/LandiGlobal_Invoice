@model IReadOnlyList<LandiGlobalTemplate.Data.ProductCatalogItem>
@using LandiGlobalTemplate.Data

@{
    ViewData["Title"] = "Produits";
    var draft = ViewData["ProductDraft"] as ProductCatalogItem ?? new ProductCatalogItem
    {
        MainDisplay = "-",
        SecondDisplay = "-",
        PaymentType = "-",
        MemoryPlan = "-",
        G4 = "-",
        GMS = "-"
    };
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Produits</h1>
            <p class="text-muted mb-0">Catalogue utilisé pour valider et enrichir les factures.</p>
        </div>
        <span class="badge bg-primary rounded-pill px-3 py-2">@Model.Count produits</span>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3">Ajouter un produit</h2>
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="ProductNumber">Product number</label>
                            <input class="form-control" id="ProductNumber" name="ProductNumber" value="@draft.ProductNumber" required maxlength="50" />
                            <span class="text-danger small" data-valmsg-for="ProductNumber"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="Model">Description</label>
                            <textarea class="form-control" id="Model" name="Model" rows="3" required>@draft.Model</textarea>
                            <span class="text-danger small" data-valmsg-for="Model"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label" for="FamilyName">Famille</label>
                                <input class="form-control" id="FamilyName" name="FamilyName" value="@draft.FamilyName" maxlength="120" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="Platform">Plateforme</label>
                                <input class="form-control" id="Platform" name="Platform" value="@draft.Platform" maxlength="120" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="HSCode">HS Code</label>
                                <input class="form-control" id="HSCode" name="HSCode" value="@draft.HSCode" maxlength="20" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="PaymentType">Paiement</label>
                                <input class="form-control" id="PaymentType" name="PaymentType" value="@draft.PaymentType" maxlength="80" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="MemoryPlan">Mémoire</label>
                                <input class="form-control" id="MemoryPlan" name="MemoryPlan" value="@draft.MemoryPlan" maxlength="80" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="G4">4G</label>
                                <input class="form-control" id="G4" name="G4" value="@draft.G4" maxlength="40" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="GMS">GMS</label>
                                <input class="form-control" id="GMS" name="GMS" value="@draft.GMS" maxlength="40" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="MainDisplay">Display 1</label>
                                <input class="form-control" id="MainDisplay" name="MainDisplay" value="@draft.MainDisplay" maxlength="50" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="SecondDisplay">Display 2</label>
                                <input class="form-control" id="SecondDisplay" name="SecondDisplay" value="@draft.SecondDisplay" maxlength="50" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-4">
                            <i class="fas fa-plus me-2"></i> Ajouter
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Product number</th>
                                <th>Description</th>
                                <th>Famille</th>
                                <th>HS Code</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@product.ProductNumber</td>
                                    <td>@product.Model</td>
                                    <td>@product.FamilyName</td>
                                    <td>@product.HSCode</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
