@model LandiGlobalTemplate.Models.CommercialInvoice

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 style="font-size: 1.5rem; margin: 0;">
            <i class="fas fa-file-invoice-dollar"></i> Invoice Details
        </h1>
        <div>
            <button type="button" id="saveDbBtn" class="btn btn-primary btn-sm" onclick="saveToDatabase()">
                <i class="fas fa-database"></i> Save to Database
            </button>
            <a href="@Url.Action("DownloadPDF")" class="btn btn-success btn-sm">
                <i class="fas fa-download"></i> Download PDF
            </a>
            <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
                <i class="fas fa-plus-circle"></i> New Upload
            </a>
        </div>
    </div>

    <!-- INVOICE INFORMATION SECTION -->
    <div class="card mb-2 shadow-sm" style="border: 1px solid #e9ecef;">
        <div class="card-header">
            <i class="fas fa-file-contract"></i> Invoice Information
        </div>
        <div class="card-body">
            @if (Model?.InvoiceInfo != null)
            {
                <table class="table-info">
                    <tr>
                        <td>Invoice Number</td>
                        <td>@Model.InvoiceInfo.InvoiceNumber</td>
                    </tr>
                    <tr>
                        <td>Invoice Date</td>
                        <td>@Model.InvoiceInfo.InvoiceDate</td>
                    </tr>
                    <tr>
                        <td>Purchase Order Number</td>
                        <td>@Model.InvoiceInfo.PurchaseOrderNumber</td>
                    </tr>
                    <tr>
                        <td>Payment Term</td>
                        <td>@Model.InvoiceInfo.PaymentTerm</td>
                    </tr>
                    <tr>
                        <td>Incoterms</td>
                        <td>@Model.InvoiceInfo.Incoterms</td>
                    </tr>
                    <tr>
                        <td>Country of Origin</td>
                        <td>@Model.InvoiceInfo.CountryOfOrigin</td>
                    </tr>
                </table>
            }
            else
            {
                <p class="text-warning mb-0">No invoice information available</p>
            }
        </div>
    </div>

    <!-- CUSTOMER INFORMATION SECTION -->
    <div class="card mb-2 shadow-sm" style="border: 1px solid #e9ecef;">
        <div class="card-header">
            <i class="fas fa-user"></i> Customer Information
        </div>
        <div class="card-body">
            @if (Model?.CustomerInfo != null)
            {
                <table class="table-info">
                    <tr>
                        <td>Customer Name</td>
                        <td>@Model.CustomerInfo.CustomerName</td>
                    </tr>
                    <tr>
                        <td>Email</td>
                        <td>@Model.CustomerInfo.Email</td>
                    </tr>
                    <tr>
                        <td>Phone</td>
                        <td>@Model.CustomerInfo.Phone</td>
                    </tr>
                    <tr>
                        <td>VAT</td>
                        <td>@Model.CustomerInfo.VAT</td>
                    </tr>
                    <tr>
                        <td>Billing Address</td>
                        <td>@Model.CustomerInfo.BillingAddress</td>
                    </tr>
                    <tr>
                        <td>Ship to address</td>
                        <td>@Model.CustomerInfo.ShipToAddress</td>
                    </tr>
                    <tr>
                        <td>Ship From Address</td>
                        <td>@Model.CustomerInfo.ShipFromAddress</td>
                    </tr>
                    <tr>
                        <td>EORI</td>
                        <td>@Model.CustomerInfo.EORI</td>
                    </tr>
                </table>
            }
            else
            {
                <p class="text-warning mb-0">No customer information available</p>
            }
        </div>
    </div>

    <!-- PRODUCT INFORMATION SECTION -->
    <div class="card shadow-sm" style="border: 1px solid #e9ecef;">
        <div class="card-header">
            <i class="fas fa-box"></i> Product Information
        </div>
        <div class="card-body">
            @if (Model?.Products != null && Model.Products.Count > 0)
            {
                <div class="table-responsive" style="margin: 0; padding: 0;">
                    <table class="table-products">
                        <thead>
                            <tr>
                                <th style="width: 10%;">Product #</th>
                                <th style="width: 15%;">Description</th>
                                <th style="width: 8%; text-align: center;">Qty</th>
                                <th style="width: 10%; text-align: right;">Unit Price</th>
                                <th style="width: 10%; text-align: right;">Total</th>
                                <th style="width: 10%;">HS Code</th>
                                <th style="width: 8%; text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td><strong>@product.ProductNumber</strong></td>
                                    <td>@product.ProductDescription</td>
                                    <td style="text-align: center;">@product.Quantity</td>
                                    <td style="text-align: right;">@product.UnitPrice.ToString("F2")</td>
                                    <td style="text-align: right;"><strong>@product.TotalAmount.ToString("F2")</strong></td>
                                    <td>
                                        <input type="text" class="form-control hs-code" 
                                               value="@product.HSCode" data-product="@product.ProductNumber" />
                                    </td>
                                    <td style="text-align: center;">
                                        <button type="button" class="btn btn-primary edit-product btn-xs" 
                                                data-product="@product.ProductNumber" data-bs-toggle="modal" 
                                                data-bs-target="#editModal">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
                    <div class="total-box" style="width: 300px;">
                        <h6>Total Amount</h6>
                        <h4>@Model.TotalAmount.ToString("F2") @Model.Currency</h4>
                    </div>
                </div>
            }
            else
            {
                <p class="text-warning mb-0">No products available</p>
            }
        </div>
    </div>
</div>

<!-- Edit Product Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Edit Product Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="productNumber" />
                    
                    <div class="mb-3">
                        <label for="familyName" class="form-label">Family Name</label>
                        <input type="text" class="form-control" id="familyName" />
                    </div>
                    
                    <div class="mb-3">
                        <label for="description" class="form-label">Product Description</label>
                        <textarea class="form-control" id="description" rows="3"></textarea>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="hsCode" class="form-label">HS Code</label>
                            <input type="text" class="form-control" id="hsCode" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="memory" class="form-label">Memory</label>
                            <input type="text" class="form-control" id="memory" />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="fourG" class="form-label">4G</label>
                            <input type="text" class="form-control" id="fourG" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="gms" class="form-label">GMS</label>
                            <input type="text" class="form-control" id="gms" />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="color" class="form-label">Color</label>
                            <input type="text" class="form-control" id="color" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="size" class="form-label">Size</label>
                            <input type="text" class="form-control" id="size" />
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="paymentType" class="form-label">Payment Type</label>
                        <input type="text" class="form-control" id="paymentType" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveChanges">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<script>
    // ========== SAVE TO DATABASE FUNCTION ==========
    function saveToDatabase() {
        const saveBtn = document.getElementById('saveDbBtn');
        
        // Disable button et afficher loading
        saveBtn.disabled = true;
        const originalText = saveBtn.innerHTML;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

        fetch('@Url.Action("SaveToDatabase")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalText;

            if (data.success) {
                // Success alert
                const alertHtml = `
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle"></i> <strong>Success!</strong> ${data.message}
                        <br><small>Invoice ID: ${data.invoiceId} | Status: <strong>${data.status}</strong></small>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                document.body.insertAdjacentHTML('afterbegin', alertHtml);

                // Afficher les erreurs de validation (si ANY)
                if (data.errors && data.errors.length > 0) {
                    const errorsHtml = `
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle"></i> <strong>Validation Warnings:</strong>
                            <ul class="mb-0">
                                ${data.errors.map(e => `<li>${e}</li>`).join('')}
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    `;
                    document.body.insertAdjacentHTML('afterbegin', errorsHtml);
                }

                // Rediriger vers les factures après 3 secondes
                setTimeout(() => {
                    window.location.href = '@Url.Action("Index", "Invoice")';
                }, 3000);
            } else {
                // Error alert
                const errorHtml = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-times-circle"></i> <strong>Error!</strong> ${data.message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                document.body.insertAdjacentHTML('afterbegin', errorHtml);
            }
        })
        .catch(error => {
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalText;
            const errorHtml = `
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-times-circle"></i> <strong>Error!</strong> ${error.message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            document.body.insertAdjacentHTML('afterbegin', errorHtml);
            console.error('Error:', error);
        });
    }

    // ========== EDIT PRODUCT LOGIC ==========
    document.querySelectorAll('.edit-product').forEach(button => {
        button.addEventListener('click', function() {
            const productNumber = this.getAttribute('data-product');
            const row = this.closest('tr');
            
            document.getElementById('productNumber').value = productNumber;
            document.getElementById('familyName').value = row.querySelector('.family-name').value;
            document.getElementById('hsCode').value = row.querySelector('.hs-code').value;
            document.getElementById('color').value = row.querySelector('.product-color').value;
            document.getElementById('size').value = row.querySelector('.product-size').value;
        });
    });

    document.getElementById('saveChanges').addEventListener('click', function() {
        const productNumber = document.getElementById('productNumber').value;
        const familyName = document.getElementById('familyName').value;
        const description = document.getElementById('description').value;
        const hsCode = document.getElementById('hsCode').value;
        const memory = document.getElementById('memory').value;
        const fourG = document.getElementById('fourG').value;
        const gms = document.getElementById('gms').value;
        const paymentType = document.getElementById('paymentType').value;
        const color = document.getElementById('color').value;
        const size = document.getElementById('size').value;

        fetch('@Url.Action("UpdateProduct")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams({
                productNumber: productNumber,
                familyName: familyName,
                description: description,
                hsCode: hsCode,
                memory: memory,
                fourG: fourG,
                gms: gms,
                paymentType: paymentType,
                color: color,
                size: size
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => console.error('Error:', error));
    });
</script>

<style>
    .card {
        border: 1px solid #dee2e6;
        border-radius: 0;
        margin-bottom: 1rem;
    }

    .card-header {
        background-color: #868e96;
        color: white;
        padding: 0.6rem 0.8rem !important;
        border-bottom: 1px solid #dee2e6;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .card-body {
        padding: 0 !important;
    }

    /* Style tableau info (Invoice, Customer) */
    .table-info {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .table-info td {
        padding: 0.5rem 0.8rem;
        border: 1px solid #dee2e6;
    }

    .table-info td:first-child {
        background-color: #868e96;
        color: white;
        font-weight: 600;
        width: 35%;
        white-space: nowrap;
    }

    .table-info td:last-child {
        background-color: white;
        font-size: 0.9rem;
    }

    .table-info tr:nth-child(even) td:first-child {
        background-color: #9fa4ab;
    }

    /* Style tableau produits */
    .table-products {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
        font-size: 0.85rem;
    }

    .table-products thead th {
        background-color: #343a40;
        color: white;
        padding: 0.5rem 0.4rem;
        text-align: left;
        font-weight: 600;
        border: 1px solid #dee2e6;
        white-space: nowrap;
    }

    .table-products tbody tr:nth-child(odd) {
        background-color: #f8f9fa;
    }

    .table-products tbody tr:nth-child(even) {
        background-color: white;
    }

    .table-products tbody td {
        padding: 0.45rem 0.4rem;
        border: 1px solid #dee2e6;
    }

    .table-products .form-control {
        font-size: 0.8rem;
        padding: 0.3rem 0.4rem;
        border: 1px solid #ced4da;
    }

    .btn-xs {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        height: 26px;
        line-height: 1.2;
    }

    .total-box {
        background-color: #e9ecef;
        border: 1px solid #dee2e6;
        padding: 0.8rem;
        text-align: right;
    }

    .total-box h6 {
        margin: 0;
        font-size: 0.9rem;
        color: #6c757d;
        margin-bottom: 0.3rem;
    }

    .total-box h4 {
        margin: 0;
        font-size: 1.2rem;
        color: #0056b3;
        font-weight: 700;
    }

    .container-fluid {
        padding-left: 0;
        padding-right: 0;
    }
</style>
